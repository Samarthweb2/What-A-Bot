# Database (Neon pooled connection — Section C)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VALIDATE_SIGNATURE=true

# Model / tool-calling agent (fill in after the 10:40-10:50 screening step)
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_FALLBACK_NAME=

# n8n notification hook (Section G) — pick ONE destination before the event
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_SHARED_SECRET=your_n8n_shared_secret_here

# Owner page protection
OWNER_PAGE_TOKEN=

# Policy threshold for holds (integer paise, Section A businesses.review_above_paise
# is per-business in the DB — this is only a bootstrap default for seeding)
DEFAULT_REVIEW_ABOVE_PAISE=100000

# Health check (Section C — external DB-touching ping every 3 min)
HEALTHCHECK_PATH=/health

# New placeholders requested
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_name_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
BREETH_API_KEY=your_breeth_api_key_here
DODO_API_KEY=your_dodo_api_key_here
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here
