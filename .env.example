# Database (Neon pooled connection — Section C)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VALIDATE_SIGNATURE=true

# Model / tool-calling agent (fill in after the 10:40-10:50 screening step)
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_FALLBACK_NAME=

# n8n notification hook (Section G) — pick ONE destination before the event
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Owner page protection
OWNER_PAGE_TOKEN=

# Policy threshold for holds (integer paise, Section A businesses.review_above_paise
# is per-business in the DB — this is only a bootstrap default for seeding)
DEFAULT_REVIEW_ABOVE_PAISE=100000

# Health check (Section C — external DB-touching ping every 3 min)
HEALTHCHECK_PATH=/health
